#!/usr/bin/env bash
# Builds the test programs, runs each under ps5slop and compares its stdout
# with tests/programs/<name>/expected.txt and its exit status with
# expected-status (0 when absent). Run inside `nix develop`.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
"$root/scripts/build-test-programs" >/dev/null
cargo build -q --release -p ps5slop --manifest-path "$root/Cargo.toml"
ps5slop="$root/target/release/ps5slop"
out="$root/target/test-programs"
failed=0

for dir in "$root"/tests/programs/*/; do
	name="$(basename "$dir")"
	want_status=0
	[ -f "$dir/expected-status" ] && want_status="$(cat "$dir/expected-status")"
	set +e
	"$ps5slop" run "$out/$name.elf" >"$out/$name.stdout" 2>"$out/$name.stderr"
	status=$?
	set -e
	if [ "$status" != "$want_status" ]; then
		echo "FAIL $name: exit status $status, expected $want_status"
		sed 's/^/  /' "$out/$name.stderr"
		failed=1
	elif ! diff -u "$dir/expected.txt" "$out/$name.stdout" >"$out/$name.diff"; then
		echo "FAIL $name: output differs"
		sed 's/^/  /' "$out/$name.diff"
		failed=1
	else
		echo "ok   $name"
	fi
done
exit "$failed"

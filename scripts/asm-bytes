#!/bin/sh
# Prints the encoding of Intel-syntax x86-64 assembly as a Rust byte list,
# for unit tests. Instructions are separated by ';'. Needs llvm-mc (nix develop).
# Usage: scripts/asm-bytes "vaddps ymm1, ymm2, ymm3; ret"
printf '%s\n' "$1" | tr ';' '\n' |
	llvm-mc --triple=x86_64 --x86-asm-syntax=intel --show-encoding |
	grep -o 'encoding: \[[^]]*\]' | sed 's/encoding: \[//; s/\]//' |
	tr '\n' ',' | sed 's/,$//; s/,/, /g'
echo

#!/usr/bin/env bash
# Builds target/ps5slop.app: the SwiftUI launcher plus the ps5slop binary and
# the FFmpeg libraries it links, ad hoc signed, then runs the upload checks.
# The shared steps are slop-app from slopsmith/ci. See docs/user/app.md.
# Usage: scripts/bundle-app
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
app=target/ps5slop.app
contents=$app/Contents
swift() { env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun swift "$@"; }

slop=$(nix build --no-link --print-out-paths .#slop-app)/bin/slop-app
commit=$("$slop" commit)
version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)

echo "== building ps5slop (release) at $commit"
SLOP_COMMIT=$commit nix develop . -c cargo build --release -p ps5slop

echo "== building the launcher"
swift build -c release --package-path apps/macos
launcher=$(swift build -c release --package-path apps/macos --show-bin-path)/ps5slop-launcher

echo "== assembling $app"
rm -rf "$app"
mkdir -p "$contents/MacOS" "$contents/Resources"
cp "$launcher" "$contents/MacOS/ps5slop-launcher"
cp target/release/ps5slop "$contents/MacOS/ps5slop"
cp scripts/fetch-fonts "$contents/Resources/fetch-fonts"
chmod u+w "$contents/MacOS/"*

iconset=$(mktemp -d)/AppIcon.iconset
swift apps/macos/Tools/make-icon.swift "$iconset"
/usr/bin/iconutil -c icns -o "$contents/Resources/AppIcon.icns" "$iconset"
rm -rf "$(dirname "$iconset")"

"$slop" plist "$app" executable=ps5slop-launcher id=dev.ps5slop.launcher name=ps5slop \
	category=games version="$version" commit="$commit"
"$slop" nix-libs "$app" Contents/MacOS/ps5slop
nix develop . -c "$slop" licenses "$app" apps/macos/Licenses crates/ps5slop/Cargo.toml
cp LICENSE "$contents/Resources/Licenses/ps5slop (GPL-2.0).txt"

echo "== signing (ad hoc)"
"$slop" sign "$app" scripts/hypervisor.entitlements Contents/MacOS/ps5slop

echo "== checking"
"$slop" check "$app" Contents/MacOS/ps5slop
echo "== done: $app"

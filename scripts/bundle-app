#!/usr/bin/env bash
# Builds target/ps5slop.app: the SwiftUI launcher plus the ps5slop binary and
# the FFmpeg libraries it links, ad hoc signed. See docs/user/app.md.
# Usage: scripts/bundle-app
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
app=target/ps5slop.app
contents=$app/Contents

echo "== building ps5slop (release)"
nix develop . -c cargo build --release -p ps5slop

echo "== building the launcher"
env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun swift build -c release --package-path apps/macos
launcher=$(env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun swift build -c release --package-path apps/macos --show-bin-path)/ps5slop-launcher

echo "== assembling $app"
rm -rf "$app"
mkdir -p "$contents/MacOS" "$contents/Frameworks" "$contents/Resources"
cp "$launcher" "$contents/MacOS/ps5slop-launcher"
cp target/release/ps5slop "$contents/MacOS/ps5slop"
cp scripts/fetch-fonts "$contents/Resources/fetch-fonts"
chmod u+w "$contents/MacOS/"*

iconset=$(mktemp -d)/AppIcon.iconset
env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun swift apps/macos/Tools/make-icon.swift "$iconset"
/usr/bin/iconutil -c icns -o "$contents/Resources/AppIcon.icns" "$iconset"
rm -rf "$(dirname "$iconset")"

version=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/ps5slop/Cargo.toml | head -n1)
cat >"$contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>ps5slop-launcher</string>
	<key>CFBundleIdentifier</key><string>dev.ps5slop.launcher</string>
	<key>CFBundleName</key><string>ps5slop</string>
	<key>CFBundleDisplayName</key><string>ps5slop</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>${version:-0.1.0}</string>
	<key>CFBundleVersion</key><string>${version:-0.1.0}</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.games</string>
	<key>LSMinimumSystemVersion</key><string>26.0</string>
	<key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

# Copies every /nix/store library the binaries need (and what those need) into
# Frameworks, and points all references at @rpath. Two different libraries can
# share a file name (Apple's and GNU's libiconv), so the second gets its store hash.
nix_deps() { otool -L "$1" | awk 'NR > 1 && $1 ~ /^\/nix\/store\// { print $1 }'; }
copied=$(mktemp)
trap 'rm -f "$copied"' EXIT

queue=("$contents/MacOS/ps5slop")
while ((${#queue[@]})); do
	file=${queue[0]}
	queue=("${queue[@]:1}")
	for dep in $(nix_deps "$file"); do
		name=$(awk -v d="$dep" '$1 == d { print $2 }' "$copied")
		if [ -z "$name" ]; then
			name=$(basename "$dep")
			if [ -e "$contents/Frameworks/$name" ]; then
				hash=$(echo "$dep" | cut -d/ -f4 | cut -c1-8)
				name="$hash-$name"
			fi
			dest="$contents/Frameworks/$name"
			cp "$dep" "$dest"
			chmod u+w "$dest"
			install_name_tool -id "@rpath/$name" "$dest" 2>/dev/null
			echo "$dep $name" >>"$copied"
			queue+=("$dest")
		fi
		install_name_tool -change "$dep" "@rpath/$name" "$file" 2>/dev/null
	done
done

for lib in "$contents/Frameworks/"*.dylib; do
	[ -e "$lib" ] || continue
	for rp in $(otool -l "$lib" | awk '/LC_RPATH/ { getline; getline; print $2 }'); do
		install_name_tool -delete_rpath "$rp" "$lib" 2>/dev/null
	done
	install_name_tool -add_rpath "@loader_path" "$lib" 2>/dev/null
done
for rp in $(otool -l "$contents/MacOS/ps5slop" | awk '/LC_RPATH/ { getline; getline; print $2 }'); do
	case $rp in /nix/store/*) install_name_tool -delete_rpath "$rp" "$contents/MacOS/ps5slop" 2>/dev/null ;; esac
done
install_name_tool -add_rpath "@executable_path/../Frameworks" "$contents/MacOS/ps5slop" 2>/dev/null

leftover=$(for f in "$contents/MacOS/"* "$contents/Frameworks/"*; do otool -L "$f" | grep /nix/store || true; done)
if [ -n "$leftover" ]; then
	echo "error: the bundle still links into /nix/store:" >&2
	echo "$leftover" >&2
	exit 1
fi

echo "== signing (ad hoc)"
for lib in "$contents/Frameworks/"*.dylib; do
	[ -e "$lib" ] && codesign -s - -f "$lib" 2>/dev/null
done
codesign -s - -f --entitlements scripts/hypervisor.entitlements "$contents/MacOS/ps5slop"
codesign -s - -f "$contents/MacOS/ps5slop-launcher"
codesign -s - -f "$app"
codesign --verify --strict --deep "$app"

echo "== done: $app"

#!/usr/bin/env bash
# Fetches reference material into references/ (gitignored, never committed).
#   references/src/FEX: FEX-Emu's handwritten x86-64 ASM tests (MIT), used by
#   ps5slop-asmtest as a hardware-checked oracle for the interpreter.
#   references/src/sharpemu: SharpEmu (GPL-2.0-or-later), whose libSceAgc
#   implementation we port.
#   references/src/sharpemu-mac: SharpEmu's macOS fork (GPL-2.0-or-later),
#   whose Metal backend, PS5 shader translator and audio code we port.
#   references/src/prosper: prosper (no license), for its console-measured
#   AGC packet bytes, used as a local test oracle only.
#   references/src/{SharpProspero,OpenAGC}: documentation of AGC functions
#   (signatures, behaviour notes), read as specs only; their code is not
#   copied (GPL-3.0, Apache-2.0).
#   references/amd: AMD's RDNA1 and RDNA2 ISA guides (AMD Specification
#   Agreement: review only, no copies) and the machine-readable ISA XML (MIT).
#   references/src/{mesa,llvm-amdgpu,isa_spec_manager}: Mesa src/amd (MIT),
#   LLVM's AMDGPU docs and target tables (Apache-2.0 with LLVM exception,
#   read only), AMD's XML parser (MIT); facts for the hardware oracle.
#   references/linux: amdgpu GFX10 PM4 and register headers (MIT).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

# fetch NAME URL COMMIT PATHS...: a sparse, shallow checkout of PATHS.
fetch() {
	local name=$1 url=$2 commit=$3
	shift 3
	local dest="$root/references/src/$name"
	if [ ! -d "$dest/.git" ]; then
		mkdir -p "$dest"
		git -C "$dest" init -q
		git -C "$dest" remote add origin "$url"
		git -C "$dest" config core.sparseCheckout true
		printf '%s\n' "$@" > "$dest/.git/info/sparse-checkout"
	fi
	git -C "$dest" fetch -q --depth 1 --filter=blob:none origin "$commit"
	git -C "$dest" checkout -q FETCH_HEAD
	echo "$name at $commit in $dest"
}

# get PATH URL SHA256: a download into references/PATH, checked by hash.
get() {
	local dest="$root/references/$1"
	mkdir -p "$(dirname "$dest")"
	[ -f "$dest" ] || curl -fsSL -o "$dest" "$2"
	echo "$3  $dest" | shasum -a 256 -c --quiet
	echo "$1"
}


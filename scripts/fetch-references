#!/usr/bin/env bash
# Fetches reference material into references/ (gitignored, never committed).
#   references/src/FEX: FEX-Emu's handwritten x86-64 ASM tests (MIT), used by
#   ps5slop-asmtest as a hardware-checked oracle for the interpreter.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
fex_commit=be66e03d65217f53a7a2e5af46473cc9a79ce3f8
dest="$root/references/src/FEX"

if [ ! -d "$dest/.git" ]; then
	mkdir -p "$dest"
	git -C "$dest" init -q
	git -C "$dest" remote add origin https://github.com/FEX-Emu/FEX.git
	git -C "$dest" config core.sparseCheckout true
	printf '%s\n' /unittests/ASM/ /LICENSE > "$dest/.git/info/sparse-checkout"
fi
git -C "$dest" fetch -q --depth 1 origin "$fex_commit"
git -C "$dest" checkout -q FETCH_HEAD
echo "FEX tests at $fex_commit in $dest/unittests/ASM"
